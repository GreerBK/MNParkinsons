# Copy this to .env and fill in your values
# Get your PAT from: airtable.com → account icon → Developer Hub → Personal Access Tokens
# Required scopes: data.records:read (add schema.bases:read to pull filter options from Airtable)
#
# These are server-side variables (no VITE_ prefix) — they stay in the Cloudflare Function
# and are never bundled into the browser JavaScript.
AIRTABLE_PAT=your_personal_access_token_here
AIRTABLE_BASE_ID=appKtPJiD3Pex9ai1
AIRTABLE_TABLE_ID=tblfEZNHgfRwvvVJc

# Separate token for the "report incorrect info" feature (/api/report).
# Scopes: data.records:read + data.records:write, access to only this base.
# Kept separate so the main token stays read-only.
AIRTABLE_WRITE_PAT=your_write_capable_token_here

# Optional — client-side key for zip→distance (free at locationiq.com, used when Zippopotam is blocked)
# VITE_LOCATIONIQ_KEY=your_free_locationiq_key
