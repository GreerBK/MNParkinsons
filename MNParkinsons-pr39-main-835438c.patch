diff --git a/tests/responsive-nav.spec.js b/tests/responsive-nav.spec.js
new file mode 100644
index 0000000000000000000000000000000000000000..06155e1aa1fd03e989c03ae00c4172c99787dff2
--- /dev/null
+++ b/tests/responsive-nav.spec.js
@@ -0,0 +1,223 @@
+import { expect, test } from '@playwright/test'
+
+const widths = [320, 360, 375, 430, 480, 600, 640, 641, 768, 1024, 1280]
+const interactionWidths = [320, 640, 641, 1280]
+const height = 740
+const textScales = [100, 125, 150, 200]
+const navigationName = 'Main site navigation'
+const homeName = "MN Parkinson's Connect home"
+
+// Enough category tiles to reach the requested scroll offset on desktop.
+const activityTypes = Array.from({ length: 36 }, (_, index) => `Activity type ${index + 1}`)
+
+test.beforeEach(async ({ page }) => {
+  await page.addInitScript(() => localStorage.setItem('mnpc_disclaimer_accepted', 'true'))
+  await page.route('**/api/activities?*', route => route.fulfill({
+    json: {
+      records: [{
+        id: 'recNavigationFixture',
+        fields: { 'Activity Name': 'Sample activity', 'Activity Type': activityTypes },
+      }],
+    },
+  }))
+  await page.route('**/api/filter-options', route => route.fulfill({ json: { activityType: activityTypes } }))
+})
+
+function navLinks(page, width) {
+  const nav = page.getByRole('navigation', { name: navigationName })
+  const submitName = width <= 640 ? 'Submit' : 'Submit an activity'
+  const searchName = width <= 640 ? 'Search' : 'Find activities near you'
+  return {
+    nav,
+    home: nav.getByRole('link', { name: homeName, exact: true }),
+    submit: nav.getByRole('link', { name: submitName, exact: true }),
+    search: nav.getByRole('link', { name: searchName, exact: true }),
+    submitName,
+    searchName,
+  }
+}
+
+async function openHome(page, width, scale = 100, url = '/#/') {
+  await page.setViewportSize({ width, height })
+  await page.goto(url)
+  if (scale !== 100) await page.addStyleTag({ content: `html { font-size: ${scale}% }` })
+  const links = navLinks(page, width)
+  await expect(links.home).toBeVisible()
+  await page.evaluate(async () => { await document.fonts.ready })
+  return links
+}
+
+for (const width of widths) {
+  for (const scale of textScales) {
+    test(`nav fits at ${width}px and ${scale}% text`, async ({ page }) => {
+      const { nav, home, submit, search, submitName, searchName } = await openHome(page, width, scale)
+      await expect(nav.getByRole('link')).toHaveCount(3)
+      await expect(home).toHaveAttribute('aria-current', 'page')
+      await expect(submit).toHaveText(submitName, { useInnerText: true })
+      await expect(search).toHaveText(searchName, { useInnerText: true })
+
+      const [navBox, homeBox, submitBox, searchBox] = await Promise.all(
+        [nav, home, submit, search].map(target => target.boundingBox()),
+      )
+      for (const target of [homeBox, submitBox, searchBox]) {
+        expect(target.width).toBeGreaterThanOrEqual(44)
+        expect(target.height).toBeGreaterThanOrEqual(44)
+        expect(target.x).toBeGreaterThanOrEqual(navBox.x)
+        expect(target.x + target.width).toBeLessThanOrEqual(navBox.x + navBox.width + 1)
+        expect(target.y).toBeGreaterThanOrEqual(navBox.y)
+        expect(target.y + target.height).toBeLessThanOrEqual(navBox.y + navBox.height + 1)
+      }
+      const navOverflow = await nav.evaluate(element => element.scrollWidth - element.clientWidth)
+      expect(navOverflow).toBeLessThanOrEqual(1)
+
+      // The two short-label buttons stay next to each other even when the logo reflows.
+      if (width <= 640 || scale === 100) {
+        expect(Math.abs(submitBox.y - searchBox.y)).toBeLessThanOrEqual(1)
+        expect(submitBox.x + submitBox.width).toBeLessThanOrEqual(searchBox.x)
+        const onSameRow = homeBox.y + homeBox.height > submitBox.y
+        if (onSameRow) expect(homeBox.x + homeBox.width).toBeLessThanOrEqual(submitBox.x)
+        if (scale <= 125) expect(onSameRow).toBe(true)
+        if (scale === 100) expect(navBox.height).toBeCloseTo(width <= 640 ? 61 : 77, 0)
+      }
+    })
+  }
+}
+
+for (const width of interactionWidths) {
+  test(`wordmark spacing and line breaks at ${width}px`, async ({ page }) => {
+    const { home } = await openHome(page, width)
+    const words = await home.evaluate(logo => {
+      const walker = document.createTreeWalker(logo, NodeFilter.SHOW_TEXT)
+      const boxes = {}
+      for (let node = walker.nextNode(); node; node = walker.nextNode()) {
+        for (const word of ['MN', "Parkinson's", 'Connect']) {
+          const start = node.textContent.indexOf(word)
+          if (start < 0) continue
+          const range = document.createRange()
+          range.setStart(node, start)
+          range.setEnd(node, start + word.length)
+          const { left, right, top } = range.getBoundingClientRect()
+          boxes[word] = { left, right, top }
+        }
+      }
+      return boxes
+    })
+    const { MN: mn, "Parkinson's": parkinsons, Connect: connect } = words
+    expect(parkinsons.left - mn.right).toBeGreaterThan(1)
+    expect(Math.abs(parkinsons.top - mn.top)).toBeLessThan(1)
+    if (width <= 640) {
+      expect(connect.top).toBeGreaterThan(parkinsons.top)
+      expect(Math.abs(connect.left - mn.left)).toBeLessThan(1)
+    } else {
+      expect(connect.left - parkinsons.right).toBeGreaterThan(1)
+      expect(Math.abs(connect.top - parkinsons.top)).toBeLessThan(1)
+    }
+  })
+}
+
+async function expectVisibleKeyboardFocus(link) {
+  await expect(link).toBeFocused()
+  await expect(link).toHaveCSS('outline-style', 'solid')
+  await expect(link).toHaveCSS('outline-width', '3px')
+}
+
+const keyboardCases = [
+  ...interactionWidths.map(width => ({ width, scale: 100 })),
+  { width: 320, scale: 200 },
+]
+
+for (const { width, scale } of keyboardCases) {
+  test(`keyboard order, focus and hash routes at ${width}px and ${scale}% text`, async ({ page }) => {
+    const { nav, home, submit, search } = await openHome(page, width, scale, '/?src=nav-regression#/')
+    const main = page.getByRole('main')
+    const skip = page.getByRole('link', { name: 'Skip to main content' })
+    await expect(main).toBeFocused()
+    for (const link of [search, submit, home, skip]) {
+      await page.keyboard.press('Shift+Tab')
+      await expectVisibleKeyboardFocus(link)
+    }
+    for (const link of [home, submit]) {
+      await page.keyboard.press('Tab')
+      await expectVisibleKeyboardFocus(link)
+    }
+    await page.keyboard.press('Enter')
+    await expect(page).toHaveURL(/\?src=nav-regression#\/submit$/)
+    await expect(page.getByRole('heading', { name: 'Submit an Activity' })).toBeVisible()
+    await expect(nav.locator('[aria-current="page"]')).toHaveCount(1)
+    await expect(submit).toHaveAttribute('aria-current', 'page')
+    await expect(main).toBeFocused()
+
+    await page.keyboard.press('Shift+Tab')
+    await expectVisibleKeyboardFocus(search)
+    await page.keyboard.press('Enter')
+    await expect(page).toHaveURL(/\?src=nav-regression#\/search$/)
+    await expect(page.getByRole('heading', { name: 'All activities' })).toBeVisible()
+    await expect(nav.locator('[aria-current="page"]')).toHaveCount(1)
+    await expect(search).toHaveAttribute('aria-current', 'page')
+    await expect(main).toBeFocused()
+
+    for (const link of [search, submit, home]) {
+      await page.keyboard.press('Shift+Tab')
+      await expectVisibleKeyboardFocus(link)
+    }
+    await page.keyboard.press('Enter')
+    await expect(page).toHaveURL(/\?src=nav-regression#\/$/)
+    await expect(page.getByRole('heading', { name: 'Find Your Community in Minnesota' })).toBeVisible()
+    await expect(nav.locator('[aria-current="page"]')).toHaveCount(1)
+    await expect(home).toHaveAttribute('aria-current', 'page')
+    await expect(main).toBeFocused()
+  })
+}
+
+test.describe('touch input', () => {
+  test.use({ hasTouch: true })
+
+  test('all three nav links respond to a tap at 320px', async ({ page }) => {
+    const { home, submit, search } = await openHome(page, 320)
+    for (const link of [submit, search, home]) {
+      await link.tap()
+      await expect(link).toHaveAttribute('aria-current', 'page')
+    }
+  })
+})
+
+const scrollCases = [
+  { width: 320, scale: 100, motion: 'reduce' },
+  { width: 320, scale: 200, motion: 'reduce' },
+  { width: 640, scale: 100, motion: 'no-preference' },
+  { width: 641, scale: 100, motion: 'reduce' },
+  { width: 1280, scale: 100, motion: 'no-preference' },
+]
+
+for (const { width, scale, motion } of scrollCases) {
+  test(`category cue aligns with sticky nav at ${width}px, ${scale}% text, motion ${motion}`, async ({ page }) => {
+    await page.emulateMedia({ reducedMotion: motion })
+    await openHome(page, width <= 640 ? 1280 : 375, scale)
+    // Change the nav's height after mount to exercise the offset at activation.
+    await page.setViewportSize({ width, height })
+    const { nav } = navLinks(page, width)
+    const cue = page.getByRole('button', { name: 'Or browse by category' })
+    const heading = page.getByRole('heading', { name: 'Browse by Category', exact: true })
+    const firstCategory = page.getByRole('button', { name: 'Find Activity type 1 activities', exact: true })
+    await expect(firstCategory).toBeAttached()
+
+    const gapFromNav = () => heading.evaluate((element, name) => {
+      const nav = document.querySelector(`nav[aria-label="${name}"]`)
+      return element.closest('section').getBoundingClientRect().top - nav.getBoundingClientRect().bottom
+    }, navigationName)
+
+    expect(await gapFromNav()).toBeGreaterThan(10)
+    if (motion === 'reduce') {
+      await cue.focus()
+      await page.keyboard.press('Enter')
+    } else {
+      await cue.click()
+    }
+    await expect(heading).toBeFocused()
+    await expect.poll(async () => Math.abs(await gapFromNav())).toBeLessThanOrEqual(2)
+    expect(Math.abs((await nav.boundingBox()).y)).toBeLessThanOrEqual(1)
+    await expect(page).toHaveURL(/#\/$/)
+    await page.keyboard.press('Tab')
+    await expect(firstCategory).toBeFocused()
+  })
+}
